# Container & Traefik Routing
MCP_CONTAINER_NAME=mcp-server
MCP_DOMAIN=mcp.odoo.plus

# Redis Configuration (Internal to mcp-net)
REDIS_CONTAINER_NAME=mcp-redis
REDIS_URL=redis://redis:6379/0

# MCP Server Transport & Network Settings
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_LOG_LEVEL=INFO
MCP_PROXY_HEADERS=true
MCP_FORWARDED_ALLOW_IPS=*
MCP_RESOURCE_SERVER_URL=https://mcp.odoo.plus/mcp

# Optional DNS Rebinding Allowlists (space-separated if multiple)
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
MCP_DISABLE_DNS_REBINDING_PROTECTION=false

# OAuth 2.0 Resource Server Configuration (Authentik)
MCP_OAUTH_ISSUER_URL=https://authentik.odoo.plus/application/o/mcp-main/
MCP_OAUTH_JWKS_URL=https://authentik.odoo.plus/application/o/mcp-main/jwks/
MCP_OAUTH_JWT_SECRET=
MCP_OAUTH_JWT_ALGORITHMS=
MCP_OAUTH_AUDIENCE=Ci48gU8Jt3cQH3pisFr6x1eegp2s2dqBf01ItInTz

# RFC 7662 OAuth 2.0 Token Introspection & Authorization Code
MCP_OAUTH_INTROSPECTION_URL=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=

MCP_HTTP_OAUTH_ISSUER_URL=
MCP_HTTP_OAUTH_JWKS_URL=
MCP_HTTP_OAUTH_JWT_SECRET=
MCP_HTTP_OAUTH_JWT_ALGORITHMS=
MCP_HTTP_OAUTH_AUDIENCE=
MCP_HTTP_OAUTH_CLIENT_ID=
MCP_HTTP_OAUTH_CLIENT_SECRET=

# Scope & Resource Enforcement
MCP_OAUTH_REQUIRED_SCOPES=
MCP_VALIDATE_TOKEN_RESOURCE=false

# Google OAuth 2.0 (for Gemini API Bearer token binding)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/generative-language.retriever https://www.googleapis.com/auth/generative-language.tuning
